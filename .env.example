# Copy to .env and fill in keys. Never commit .env.
#
# Hong Kong note:
#   Direct OpenAI API is often unavailable. Prefer HKBU GenAI gateway.
#   Diagnosis (all languages) → HKBU GenAI (gpt-4.1-mini)
#   Video ASR still needs OpenAI Whisper or Zhipu ASR if you have those keys.

DIAGNOSIS_PROVIDER_YUE=hkbu
DIAGNOSIS_PROVIDER_EN=hkbu
DIAGNOSIS_PROVIDER_CMN=hkbu

HKBU_API_KEY=
HKBU_DEPLOYMENT=gpt-4.1-mini
HKBU_API_VERSION=2024-05-01-preview
# HKBU_API_BASE=https://genai.hkbu.edu.hk/general/rest

# Optional video ASR
OPENAI_API_KEY=
ZHIPUAI_API_KEY=
ASR_PROVIDER_YUE=openai
ASR_PROVIDER_EN=openai
ASR_PROVIDER_CMN=zhipu
