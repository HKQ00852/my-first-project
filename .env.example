# Copy to .env and fill in keys. Never commit .env.
#
# Diagnosis → HKBU GenAI (works in Hong Kong)
# Video ASR → local Whisper by default (no OpenAI needed)

DIAGNOSIS_PROVIDER_YUE=hkbu
DIAGNOSIS_PROVIDER_EN=hkbu
DIAGNOSIS_PROVIDER_CMN=hkbu

HKBU_API_KEY=
HKBU_DEPLOYMENT=gpt-4.1-mini
HKBU_API_VERSION=2024-05-01-preview

ASR_PROVIDER_YUE=local
ASR_PROVIDER_EN=local
ASR_PROVIDER_CMN=local
WHISPER_MODEL=base

# Optional cloud ASR overrides
OPENAI_API_KEY=
ZHIPUAI_API_KEY=
