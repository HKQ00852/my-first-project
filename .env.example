# Copy to .env and fill in keys. Never commit .env.
#
# Language routing (default):
#   粵語 (zh-Hant) + English → OpenAI (Whisper ASR + GPT diagnosis)
#   普通话 (zh-Hans)         → 智谱 (ASR + GLM diagnosis)

ASR_PROVIDER_YUE=openai
ASR_PROVIDER_EN=openai
ASR_PROVIDER_CMN=zhipu

DIAGNOSIS_PROVIDER_YUE=openai
DIAGNOSIS_PROVIDER_EN=openai
DIAGNOSIS_PROVIDER_CMN=zhipu

OPENAI_API_KEY=
ZHIPUAI_API_KEY=
# DEEPSEEK_API_KEY=

# Optional model overrides
# OPENAI_ASR_MODEL=whisper-1
# OPENAI_CHAT_MODEL=gpt-4o-mini
# ZHIPU_ASR_MODEL=glm-asr-2512
# ZHIPU_CHAT_MODEL=glm-4-flash
